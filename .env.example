# Copy to .env and add your key. .env is gitignored.
GROQ_API_KEY=

# Groq's free tier limits each model separately, so the agent and the simulated shopper
# use different models and do not share a quota. Check your limits in the Groq console.
AGENT_MODEL=openai/gpt-oss-20b
SHOPPER_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=openai/gpt-oss-120b

# gpt-oss models reason before answering; "low" keeps tokens and latency down.
# Leave empty for models that do not accept the parameter.
REASONING_EFFORT=low

# Reasoning tokens count toward these. Raise one if you see "hit max_completion_tokens".
# AGENT_MAX_TOKENS=900
# SHOPPER_MAX_TOKENS=600
# JUDGE_MAX_TOKENS=1500

# AGENT_TEMPERATURE=0.3
# SHOPPER_TEMPERATURE=0.8
# LLM_JSON_MODE=1
# Leave LLM_SEED empty to send no seed.
# LLM_SEED=7
# Any OpenAI-compatible endpoint works:
# LLM_BASE_URL=https://api.groq.com/openai/v1
